# Copy to .env (which is git-ignored) and fill in. Never commit the real token.
QA_API_TOKEN=put-the-development-token-here
TEAM_NAME=team-XX
MODEL_DIR=model
# Optional: override the threshold saved in model/qa_meta.json
# QA_NULL_THRESHOLD=0.0
# Optional: force the inference device (cpu or cuda). Default: cuda if available.
# QA_DEVICE=cpu
